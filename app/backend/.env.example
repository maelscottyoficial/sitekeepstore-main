# ============================================================
# Keep Store Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# All variables prefixed with comments are REQUIRED unless noted.

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# PostgreSQL connection URL using asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/keepstore

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# JWT (Application tokens issued after OIDC login)
# ------------------------------------------------------------
# Secret key used to sign/verify application JWT tokens (generate a strong random string)
JWT_SECRET_KEY=change-me-generate-a-strong-random-secret

# Algorithm for JWT signing (default: HS256)
JWT_ALGORITHM=HS256

# Token expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# OIDC (OpenID Connect) Provider
# ------------------------------------------------------------
# Your OIDC provider's issuer URL (e.g., https://your-tenant.auth0.com, https://keycloak.example.com/realms/myrealm)
OIDC_ISSUER_URL=https://your-oidc-provider.example.com

# Client ID registered with your OIDC provider
OIDC_CLIENT_ID=your-oidc-client-id

# Client secret registered with your OIDC provider
OIDC_CLIENT_SECRET=your-oidc-client-secret

# OIDC scopes to request (space-separated)
OIDC_SCOPE=openid profile email

# ------------------------------------------------------------
# Admin User
# ------------------------------------------------------------
# UUID of the admin user (this user gets the "admin" role automatically on startup)
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# Email of the admin user
ADMIN_USER_EMAIL=admin@example.com

# ------------------------------------------------------------
# Frontend URL
# ------------------------------------------------------------
# Where the frontend is hosted (used for logout redirect, CORS, etc.)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Mercado Pago (Optional - for payment integration)
# ------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=